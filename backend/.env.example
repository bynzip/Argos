SECRET_KEY=django-insecure-example-key-replace-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database configuration
# Default branch mode: SQLite for quick local startup.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
SQLITE_TIMEOUT=20

