SECRET_KEY=django-insecure-example-key-replace-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database configuration
DB_ENGINE=postgresql
DB_NAME=argos_fase1_demo
DB_USER=admin
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=5432

# SQLite alternative for local development
# Change DB_ENGINE=sqlite to enable it.
# SQLITE_NAME can be a filename like db.sqlite3 or an absolute path.
SQLITE_NAME=db.sqlite3
SQLITE_TIMEOUT=20
